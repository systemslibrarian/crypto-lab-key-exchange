{
  "name": "crypto-lab-key-exchange",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test --test-timeout=120000 scripts/engine.test.mjs scripts/merkle.test.mjs scripts/merkle-review.test.mjs scripts/mutation-report.test.mjs",
    "test:mutations": "node scripts/mutations.mjs",
    "smoke": "node scripts/smoke.mjs",
    "axe": "node scripts/axe.mjs",
    "verify": "npm run build && npm test && npm run smoke && npm run axe",
    "test:a11y": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "axe-core": "4.14.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1"
  }
}
